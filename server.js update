function json(res, status, value) {
  const body = JSON.stringify(value);
  res.writeHead(status, {
    'Content-Type': 'application/json; charset=utf-8',
    'Content-Length': Buffer.byteLength(body),
    'Cache-Control': 'no-store',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type,Authorization'
  });
  res.end(body);
}
function readBody(req) {
  return new Promise((resolve, reject) => {
    let body = '';
    req.on('data', chunk => {
      body += chunk;
      if (body.length > 1_000_000) { reject(new Error('Request body too large')); req.destroy(); }
    });
    req.on('end', () => {
      try { resolve(JSON.parse(body || '{}')); }
      catch { reject(new Error('Request body must be valid JSON')); }
    });
    req.on('error', reject);
  });
}
async function fetchJson(url, options = {}) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 25000);
  try {
    const response = await fetch(url, { ...options, signal: controller.signal });
    const text = await response.text();
    let data; try { data = JSON.parse(text); } catch { data = { raw: text }; }
    if (!response.ok) {
      const err = new Error(`${response.status}: ${data?.error?.message || data?.message || data?.raw || text || response.statusText}`);
      err.status = response.status;
      throw err;
    }
    return data;
  } finally { clearTimeout(timer); }
}
async function catalogue(provider) {
  const cached = catalogueCache.get(provider.name);
  if (cached && Date.now() - cached.time < CATALOGUE_TTL_MS) return cached.models;
  const data = await fetchJson(provider.base + '/models', {
    headers: { Authorization: 'Bearer ' + provider.key, ...(provider.headers || {}) }
  });
  const models = Array.isArray(data.data) ? data.data : [];
  catalogueCache.set(provider.name, { time: Date.now(), models });
  return models;
}
function providers() {
  const list = [];
  if (OR_KEY) list.push({
    name: 'OpenRouter', key: OR_KEY, base: OR_BASE,
    headers: { 'HTTP-Referer': 'https://pelex.tech', 'X-Title': 'Pelex Public Agent' },
    primary: 'openrouter/free'
  });
  if (GROQ_KEY) list.push({
    name: 'Groq', key: GROQ_KEY, base: GROQ_BASE, headers: {},
    primary: GROQ_PRIMARY
  });
  return list;
}
function isFreeOpenRouter(model) {
  if (!model || !model.id || model.id === 'openrouter/free') return false;
  if (/:free$/i.test(model.id)) return true;
  const p = model.pricing || {};
  const prompt = Number(p.prompt);
  const completion = Number(p.completion);
  return Number.isFinite(prompt) && Number.isFinite(completion) && prompt === 0 && completion === 0;
}
function isChatModel(model) {
  const id = String(model?.id || '').toLowerCase();
  if (!id || /whisper|transcri|tts|text-to-speech|embedding|moderation|guard|rerank|image|vision-only|audio|speech|safeguard/.test(id)) return false;
  if (model.active === false) return false;
  const architecture = model.architecture || {};
  const modality = String(architecture.modality || '').toLowerCase();
  if (modality && !modality.includes('text')) return false;
  return true;
}
async function candidates(provider) {
  const out = [provider.primary];
  try {
    const models = await catalogue(provider);
    let discovered;
    if (provider.name === 'OpenRouter') {
      discovered = models.filter(isFreeOpenRouter).map(m => m.id);
    } else {
      discovered = models.filter(isChatModel).map(m => m.id);
    }
    for (const id of discovered) if (id && !out.includes(id)) out.push(id);
  } catch (e) {
    console.error(`[${provider.name}] model discovery failed: ${e.message}`);
  }
  return out;
}
async function callModel(provider, model, messages) {
  const data = await fetchJson(provider.base + '/chat/completions', {
    method: 'POST',
    headers: {
      Authorization: 'Bearer ' + provider.key,
      'Content-Type': 'application/json',
      ...(provider.headers || {})
    },
    body: JSON.stringify({ model, messages, temperature: 0.6, max_tokens: 1200 })
  });
  const answer = data?.choices?.[0]?.message?.content;
  if (typeof answer !== 'string' || !answer.trim()) throw new Error('Model returned an empty answer');
  return answer.trim();
}
async function chat(message) {
  const messages = [
    { role: 'system', content: 'You are Uncle Pelex AI assistant. Be friendly, clear, professional, and helpful. If you do not know something, say so honestly.' },
    { role: 'user', content: message }
  ];
  const list = providers();
  if (!list.length) throw new Error('No API key configured. Add OPENROUTER_API_KEY and/or GROQ_API_KEY in Render Environment Variables.');
  const errors = [];
  for (const provider of list) {
    const models = await candidates(provider);
    // Bound fallback attempts so a broken catalogue cannot cause a long deployment test.
    for (const model of models.slice(0, 12)) {
      try {
        const reply = await callModel(provider, model, messages);
        return { reply, provider: `${provider.name} / ${model}` };
      } catch (e) {
        errors.push(`${provider.name} ${model}: ${e.message}`);
        console.error(`[model fallback] ${provider.name} ${model} failed: ${e.message}`);
        // Invalid model/auth/permission errors should move on to the next candidate immediately.
      }
    }
  }
  throw new Error('All available models failed. ' + errors.slice(-5).join(' | '));
}
const server = http.createServer(async (req, res) => {
  if (req.method === 'OPTIONS') {
    res.writeHead(204, {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type,Authorization',
      'Access-Control-Max-Age': '86400'
    });
    return res.end();
  }
  const path = new URL(req.url, 'http://localhost').pathname;
  if (req.method === 'GET' && (path === '/' || path === '/index.html')) {
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
    return res.end(html);
  }
  if (req.method === 'GET' && path === '/health') {
    return json(res, 200, {
      ok: true,
      service: 'Pelex Public Agent test server',
      configuredProviders: providers().map(p => p.name),
      hasOpenRouterKey: Boolean(OR_KEY),
      hasGroqKey: Boolean(GROQ_KEY)
    });
  }
  if (req.method === 'POST' && path === '/chat') {
    try {
      const body = await readBody(req);
      const message = typeof body.message === 'string' ? body.message.trim() : '';
      if (!message) return json(res, 400, { error: 'Please enter a message.' });
      if (message.length > 12000) return json(res, 413, { error: 'Message is too long. Please keep it under 12,000 characters.' });
      const result = await chat(message);
      return json(res, 200, result);
    } catch (e) {
      console.error('[chat error]', e.message);
      return json(res, 502, { error: e.message || 'The chat request failed.' });
    }
  }
  return json(res, 404, { error: 'Not found' });
});
server.listen(PORT, '0.0.0.0', () => {
  console.log(`Pelex Public Agent test server listening on ${PORT}`);
  console.log(`Configured providers: ${providers().map(p => p.name).join(', ') || 'NONE — add API keys in Render Environment Variables'}`);
});