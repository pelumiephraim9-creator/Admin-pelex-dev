// Pelex Public Agent — standalone test server
// Node.js 18+. No npm packages required.
// Required env vars: OPENROUTER_API_KEY and/or GROQ_API_KEY
// Optional: PORT, OPENROUTER_BASE, GROQ_BASE, GROQ_MODEL
const http = require('node:http');

const PORT = Number(process.env.PORT || 3000);
const OR_KEY = process.env.OPENROUTER_API_KEY || '';
const GROQ_KEY = process.env.GROQ_API_KEY || '';
const OR_BASE = (process.env.OPENROUTER_BASE || 'https://openrouter.ai/api/v1').replace(/\/+$/, '');
const GROQ_BASE = (process.env.GROQ_BASE || 'https://api.groq.com/openai/v1').replace(/\/+$/, '');
const GROQ_PRIMARY = process.env.GROQ_MODEL || 'llama-3.3-70b-versatile';
const CATALOGUE_TTL_MS = 10 * 60 * 1000;
const catalogueCache = new Map();

const html = String.raw`<!doctype html>
