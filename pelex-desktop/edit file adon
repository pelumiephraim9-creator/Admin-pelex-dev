  var part=Math.min(100,Math.round(Math.abs(prof)/base*100)), col=prof>=0?'#15803d':'#b91c1c';
  var ring='conic-gradient(#0b1b4a 0% '+(100-part)+'%, '+col+' '+(100-part)+'% 100%)';
  tile.id='pxPieTile';
  tile.innerHTML='<div style="display:flex;gap:14px;align-items:center;padding:8px"><div style="width:110px;height:110px;border-radius:50%;background:'+ring+';flex:none;position:relative"><div style="position:absolute;inset:26px;border-radius:50%;background:#fff"></div></div>'+
   '<div style="font-size:13px"><b>Startup balance</b><div>Foundation '+esc(money(d.foundation,c))+'</div><div style="color:'+col+'">'+(prof>=0?'Profit':'Loss')+' so far '+esc(money(Math.abs(prof),c))+'</div><div><b>Balance '+esc(money(d.balance,c))+'</b></div></div></div>';
 }
 setInterval(function(){ analysis(); pie(); }, 3000);
})();
